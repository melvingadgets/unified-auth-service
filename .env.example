# Auth Service Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=5500

# Database (use a SEPARATE MongoDB instance for the auth service)
DATABASE_URL=mongodb+srv://your_connection_string_here

# JWT (this secret MUST be shared with consumer backends)
AUTH_JWT_SECRET=replace_with_long_random_secret

# Service-to-service authentication key (backends use this to call internal endpoints)
AUTH_SERVICE_KEY=replace_with_long_random_service_key

# Public URL of this auth service (used for email verification/reset links).
# Also the `iss` of every RS256 token: receivers compare it exactly.
AUTH_SERVICE_PUBLIC_URL=http://localhost:5500

# RS256 platform tokens (Shortwork/AGENTS.md §2). Generate with `npm run keys:rotate -- <out-file>`
# and copy the two lines from that file. Unset = legacy HS256 tokens only.
AUTH_SIGNING_KEYS_B64=
AUTH_ACTIVE_KID=
# Lifetime of a session's refresh token, in days.
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# OAuth clients, one per backend (hashes only). Generate with
# `npm run clients:rotate -- <out-dir> easybuy store market relay`; each backend gets its
# SERVICE_CLIENT_ID / SERVICE_CLIENT_SECRET from <out-dir>/<service>.client.env.
AUTH_OAUTH_CLIENTS_B64=

# The relay's JWKS, for the signatures on event deliveries to /internal/events (in-app
# notifications, Shortwork/docs/notifications.md). Production: http://relay.railway.internal:8080/.well-known/jwks.json
# Unset = /internal/events answers 503 and the relay holds the events until it is set.
RELAY_JWKS_URL=

# Web Push alerts for in-app notifications (Shortwork/docs/notifications.md §8). All three set = on;
# any missing = GET /me/push/config answers enabled:false and nothing is sent.
# One key pair per environment, made once with: npx web-push generate-vapid-keys
# Changing the pair later silently orphans every saved device until each one subscribes again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services, e.g. mailto:alerts@example.com
VAPID_SUBJECT=
# Tests and the e2e harness only: extra push hosts, comma-separated. Plain http is allowed only
# for a loopback host listed here. Leave unset in every deployed environment.
PUSH_ALLOWED_HOSTS=

# Login/register/recovery attempts per client IP per 15 minutes.
AUTH_RATE_LIMIT=10

# Read token for the private @melvingadgets/platform-kit package (GitHub, read:packages only).
NPM_TOKEN=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# CORS (comma-separated list of allowed origins, or * for all)
#
# This is the list of every browser origin that signs in against auth, and it fails closed: an
# origin that is not here gets no Access-Control-Allow-Origin, and because credentials are on the
# `cors` package can never fall back to "*". The browser then discards the response, which surfaces
# in the app as sign-in silently doing nothing. Whenever an app ships, add its production origin
# here in the same change — the finance app is https://aurapaytracker.vercel.app, the standalone
# Apply app https://easybuy-frontend-bbox.vercel.app, the store https://www.melvingadgets.com, and
# Melvin OS https://melvin-os-pink.vercel.app. Trailing slashes never match.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email / SMTP / Resend Configuration
#
# These are BLANK on purpose. A non-empty placeholder used to pass the "is mail configured" check,
# so a copied .env looked configured, registration tried to send, the provider rejected the fake
# credential, and the person was told "unable to create user" for an account that had already been
# created (fixed 2026-10-30). Blank means: mail is off, and accounts are verified immediately.
#
# Fill in a real set to turn email verification on. Examples of the shape:
#   MAIL_PROVIDER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM="Unified Auth <noreply@yourdomain.com>"
# or, for Gmail SMTP (MAIL_PROVIDER=smtp is the default):
#   GMAIL_USER=noreply@yourdomain.com
#   GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_PROVIDER=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
