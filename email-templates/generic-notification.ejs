<%- include('./partials/header') %>
<% 
  const effectiveUrl = (typeof ctaUrl !== 'undefined' && ctaUrl) ? ctaUrl : (typeof actionUrl !== 'undefined' && actionUrl) ? actionUrl : '';
  const effectiveText = (typeof ctaText !== 'undefined' && ctaText) ? ctaText : (typeof actionText !== 'undefined' && actionText) ? actionText : 'View Details';
  const effectiveNote = (typeof note !== 'undefined' && note) ? note : (typeof footerNote !== 'undefined' && footerNote) ? footerNote : '';
%>

<p class="text-lg"><%= typeof title !== 'undefined' && title ? title : 'Notification' %></p>
<% if (typeof subtitle !== 'undefined' && subtitle) { %>
  <p class="text-md text-color"><%= subtitle %></p>
<% } else if (typeof userName !== 'undefined' && userName) { %>
  <p class="text-md text-color">Hello <%= userName %>,</p>
<% } %>

<% if (typeof message !== 'undefined' && message) { %>
  <p class="regular-text"><%= message %></p>
<% } %>

<% if (typeof items !== 'undefined' && Array.isArray(items) && items.length > 0) { %>
  <table class="info-table">
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td class="label"><%= item.label %></td>
          <td class="val"><%= item.value %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<% if (effectiveUrl) { %>
  <div style="text-align: center;">
    <a href="<%= effectiveUrl %>" class="btn"><%= effectiveText %></a>
  </div>
<% } %>

<% if (effectiveNote) { %>
  <p class="regular-text" style="font-size: 13px; color: #888888;"><%= effectiveNote %></p>
<% } %>

<%- include('./partials/footer') %>
