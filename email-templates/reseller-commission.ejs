<%- include('./partials/header') %>

<p class="text-lg">Commission Earned!</p>
<p class="text-md text-color">Great work, <%= typeof resellerName !== 'undefined' && resellerName ? resellerName : 'Partner' %></p>

<p class="regular-text">
  You have earned a new commission on the Melvin Reseller Programme!
</p>

<table class="info-table">
  <tbody>
    <% if (typeof commissionAmount !== 'undefined' && commissionAmount) { %>
      <tr>
        <td class="label">Commission</td>
        <td class="val"><%= commissionAmount %></td>
      </tr>
    <% } %>
    <% if (typeof transactionType !== 'undefined' && transactionType) { %>
      <tr>
        <td class="label">Activity</td>
        <td class="val"><%= transactionType %></td>
      </tr>
    <% } %>
    <% if (typeof date !== 'undefined' && date) { %>
      <tr>
        <td class="label">Date</td>
        <td class="val"><%= date %></td>
      </tr>
    <% } %>
  </tbody>
</table>

<div style="text-align: center;">
  <a href="<%= typeof balanceUrl !== 'undefined' && balanceUrl ? balanceUrl : 'https://melvin-os-pink.vercel.app' %>" class="btn">View Reseller Dashboard</a>
</div>

<p class="regular-text">
  Commissions are accumulated and disbursed automatically every Sunday to your verified bank account.
</p>

<%- include('./partials/footer') %>
