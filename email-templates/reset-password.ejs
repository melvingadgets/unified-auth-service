<%- include('./partials/header') %>

<p class="text-lg">Reset Password</p>
<p class="text-md text-color">Hello <%= typeof fullName !== 'undefined' && fullName ? fullName : '' %></p>

<p class="regular-text">
  We received a request to reset the password for your Melvin Gadgets account. Click the button below to choose a new password. This link is only valid for a limited time.
</p>

<div style="text-align: center;">
  <a href="<%= resetUrl %>" class="btn">Reset Password</a>
</div>

<p class="regular-text">
  If you did not request a password reset, you can safely ignore this email. Your account remains secure.
</p>

<div class="link-fallback">
  Having trouble with the button? Copy and paste this link into your browser:<br>
  <a href="<%= resetUrl %>" style="color: #026873;"><%= resetUrl %></a>
</div>

<%- include('./partials/footer') %>
