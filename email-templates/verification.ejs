<%- include('./partials/header') %>
<% const linkUrl = typeof verifyUrl !== 'undefined' ? verifyUrl : (typeof verificationUrl !== 'undefined' ? verificationUrl : (typeof actionUrl !== 'undefined' ? actionUrl : '#')); %>
<% const displayName = typeof fullName !== 'undefined' && fullName ? fullName : (typeof userName !== 'undefined' && userName ? userName : 'Valued Customer'); %>

<p class="text-lg">Welcome</p>
<p class="text-md text-color"><%= displayName %></p>

<p class="regular-text">
  Thank you for signing up with Melvin Gadgets. To complete your registration and secure your account across all Melvin services, please verify your email address.
</p>

<div style="text-align: center;">
  <a href="<%= linkUrl %>" class="btn">Verify Account</a>
</div>

<p class="regular-text">
  If you did not initiate this request or create an account with Melvin Gadgets, please disregard this email.
</p>

<div class="link-fallback">
  Having trouble with the button? Copy and paste this link into your browser:<br>
  <a href="<%= linkUrl %>" style="color: #026873;"><%= linkUrl %></a>
</div>

<%- include('./partials/footer') %>
